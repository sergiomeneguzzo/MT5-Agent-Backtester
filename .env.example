# MetaTrader 5 built-in MCP server (Tools > Options > MCP > Enable + Generate key, then restart MT5).
# The server only listens on 127.0.0.1. Never commit the real .env.
MT5_MCP_URL=http://127.0.0.1:22346/mcp
MT5_MCP_KEY=paste-your-terminal-key-here

# Optional: MetaEditor server (compiler). Not needed for backtests.
METAEDITOR_MCP_URL=http://127.0.0.1:22345/mcp
METAEDITOR_MCP_KEY=
